# Nusxa oling: cp .env.example .env   (.env GIT'ga TUSHMAYDI)

# Telegram bot tokeni — @BotFather dan olinadi.
# Mini ilovaning initData imzosi shu token bilan tekshiriladi.
BOT_TOKEN=

# 1 = Telegram'ga HECH NARSA yuborilmaydi (xabarlar faqat bazadagi tg_outbox jadvaliga yoziladi).
# Sinab ko'rayotganda 1 qoldiring; haqiqiy ishga tushirganda 0 qiling.
SHADOW=1

# Saytning tashqi manzili (Telegram xabaridagi tugma shuni ochadi)
PUBLIC_URL=https://trello.example.com
TZ=Asia/Tashkent

# ── Ixtiyoriy ──
# ISH_OCHIQ=0          # 0 — faqat sozlama.js dagi KORADI ro'yxati kiradi; 1 — hamma xodimga ochiq
# ISH_FAYL_CHAT=       # bo'sh — fayllar diskda (/data/files). Kanal id berilsa VA SHADOW=0 bo'lsa — Telegram kanalida
# CRON=1               # 0 — har kuni 09:30 dagi eslatmalar o'chiq
